# ── Runs fully local and free with no settings at all. ──

PORT=3000
# Use 0.0.0.0 when deploying behind a public URL, and set ALLOWED_HOSTS.
HOST=127.0.0.1
# ALLOWED_HOSTS=scamshield.example.com,localhost

# Shared secret for the /mcp endpoint (recommended when public).
# Clients send:  Authorization: Bearer <key>
# SCAMSHIELD_API_KEY=change-me

# Who is being protected, and who gets alerts.
PROTECTED_PERSON_NAME=Grandma
TRUSTED_CONTACT_NAME=Aiperi
AUTO_ALERT_ON_SCAM=1

# ── AWS (optional). Run ./infra/setup-aws.sh first. ──
# SCAMSHIELD_AWS=1
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# INCIDENTS_TABLE=scamshield-incidents
# ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:scamshield-family-alerts
